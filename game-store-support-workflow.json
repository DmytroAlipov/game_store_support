    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst list = Array.isArray(raw) ? raw\n  : Array.isArray(raw.items) ? raw.items\n  : Array.isArray(raw.games) ? raw.games\n  : Array.isArray(raw.data) ? raw.data\n  : $input.all().map(i => i.json);\n\nconst compact = list.slice(0, 400).map(g => ({\n  id: g.id ?? g.game_id,\n  title: g.title ?? g.name,\n  platform: g.platform ?? g.platforms,\n  genre: g.genre ?? g.genres\n})).filter(g => g.id && g.title);\n\nconst catalogText = compact.length\n  ? compact.map(g => `${g.id} | ${g.title} | ${[].concat(g.platform ?? []).join('/')} | ${[].concat(g.genre ?? []).join('/')}`).join('\\n')\n  : 'CATALOG UNAVAILABLE - use elasticsearch_game_search to find games.';\n\nreturn [{ json: { catalogText, catalogSize: compact.length } }];"
      },
