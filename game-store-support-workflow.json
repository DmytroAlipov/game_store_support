        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"safe\": {\n      \"type\": \"boolean\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"clean\",\n        \"prompt_injection\",\n        \"jailbreak\",\n        \"system_prompt_extraction\",\n        \"malicious_payload\",\n        \"pii_exfiltration\",\n        \"abuse\",\n        \"off_topic_harmful\",\n        \"empty\"\n      ]\n    },\n    \"risk\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"safe\",\n    \"category\",\n    \"risk\",\n    \"reason\"\n  ]\n}"
