    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nlet source = 'webhook';\nlet userId = 'anonymous';\nlet message = '';\nlet name = '';\n\nif (Array.isArray(j.messages)) {\n  const m = j.messages[0] ?? {};\n  source = 'whatsapp';\n  userId = String(m.from ?? 'anonymous');\n  message = m.text?.body ?? '';\n  name = j.contacts?.[0]?.profile?.name ?? '';\n} else {\n  const b = j.body ?? j;\n  userId = String(b.userId ?? b.sessionId ?? 'anonymous');\n  message = String(b.message ?? '');\n  name = String(b.name ?? '');\n}\n\nmessage = String(message).replace(/\\u0000/g, '').trim().slice(0, 2000);\n\nreturn [{ json: { source, userId, name, message, sessionId: `${source}:${userId}` } }];"
      },
